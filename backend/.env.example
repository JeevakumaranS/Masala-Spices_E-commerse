APP_ENV=development
DATABASE_URL=postgresql+asyncpg://masala:change-me@localhost:5432/masala_db
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$
ADMIN_TOKEN_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/replace-with-your-deployment-id/exec

RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
RUSTFS_BUCKET=masaladb
RUSTFS_LEGACY_BUCKET=masala-store
